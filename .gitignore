# =========================================================================
# БИЛД-СИСТЕМА (Gradle)
# =========================================================================
.gradle/
**/build/
build/
gradle-app.setting
*.gradle.kts.html

# Запрещаем коммитить локальные настройки Gradle (память, прокси)
/gradle.properties
# НО разрешаем, если вы хотите делить общие настройки с командой. 
# Если gradle.properties содержит конфиги проекта, удалите строчку выше.

# Локальный кэш конфигурации Gradle
.configuration-cache/

# Включаем обертку Gradle (Gradle Wrapper) — она ОБЯЗАТЕЛЬНО должна быть в Git
!gradle-wrapper.jar
!gradlew
!gradlew.bat

# =========================================================================
# СРЕДА РАЗРАБОТКИ (Android Studio / IntelliJ IDEA)
# =========================================================================
# Полностью игнорируем локальные настройки IDE
.idea/
*.iml
*.ipr
*.iws
.navigation/

# Локальное состояние задач и конфигураций
out/

# =========================================================================
# КОТЛИН (Kotlin)
# =========================================================================
.kotlin/
**/kotlin-js-store/

# =========================================================================
# АНДРОИД (Специфика SDK, Ключи и Сборки)
# =========================================================================
# Локальные пути к Android SDK и NDK (индивидуально для каждого ПК)
local.properties

# Результаты сборки приложения (APK, App Bundle, дебаг-логи)
*.apk
*.ap_
*.aab
*.dex
captures/
output.json

# Профайлер и нативный код (C++)
.externalNativeBuild/
.cxx/
ndkBuild/

# КЛЮЧИ ПОДПИСИ И СЕКРЕТЫ (Критически важно не залить на GitHub!)
*.jks
*.keystore
*.p12
key.properties
secrets.properties

# =========================================================================
# СИСТЕМНЫЕ ФАЙЛЫ
# =========================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Логи и дампы памяти при вылетах студии
*.log
*.hprof
